# Komodo app.env.sample
# Copy to app.env and customize

# Timezone
TZ=America/New_York

# Hostname / domain
BASE_HOST_NAME=myhostname
BASE_DOMAIN_NAME=example.com

# Organization name (displayed in UI)
APP_ORG_NAME=Komodo

# JWT / webhook secrets (min 32 chars)
APP_SECRET_KEY=changeme_secret_key_min_32_chars
RPC_SECRET=changeme_webhook_secret

# Database credentials
DB_USER_NAME=komodo
DB_ADMIN_PASS=changeme_admin_password
